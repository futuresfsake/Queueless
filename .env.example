# API connects as the NON-OWNER role (RLS applies). Migrations use the owner role.
DATABASE_URL=postgresql://queueless_app:queueless_app@localhost:5432/queueless
MIGRATION_DATABASE_URL=postgresql://queueless_owner:queueless_owner@localhost:5432/queueless
JWT_SECRET=change-me-in-real-env
CORS_ORIGINS=http://localhost:5173
PORT=3000
CLINIC_TZ=Asia/Manila
