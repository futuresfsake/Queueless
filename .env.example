# API connects as the NON-OWNER role (RLS applies). Migrations use the owner role.
DATABASE_URL=postgresql://queueless_app:queueless_app@localhost:5434/queueless
MIGRATION_DATABASE_URL=postgresql://queueless_owner:queueless_owner@localhost:5434/queueless
JWT_SECRET=change-me-in-real-env
CORS_ORIGINS=http://localhost:5173
PORT=3000
CLINIC_TZ=Asia/Manila
# Set to 1 only when running behind a reverse proxy (Railway/Vercel); keeps per-IP login limits honest.
# TRUST_PROXY=1
# Tests lower this for speed; production default is 16 (must be >= 15 when NODE_ENV=production).
# PASSWORD_SCRYPT_LOG_N=16
# For: pnpm --filter @queueless/api seed:super-admin  (pass on the command line; do not commit real values)
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# Used by db:setup (src/scripts/migrate.ts) to set the app role password. Local placeholder.
APP_DB_PASSWORD=queueless_app
# Production-only (Railway), see docs/ops/deployment-runbook.md. Remove PROVISION_DATABASE_URL after the first deploy.
# PROVISION_DATABASE_URL=   (superuser connection, first deploy only)
# OWNER_PASSWORD=           (password for queueless_owner, required with PROVISION_DATABASE_URL)
